<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/snapnotes_background"
    android:padding="24dp">

    <TextView
        android:id="@+id/tv_note_detail_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sample Note Title"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/snapnotes_on_surface"
        android:paddingBottom="8dp"/>

    <TextView
        android:id="@+id/tv_note_detail_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sample content."
        android:textSize="18sp"
        android:textColor="@color/snapnotes_on_surface" />

</LinearLayout>
